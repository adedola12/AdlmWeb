# Environment files — never commit secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# Credential files
*.pem
*.key
*.pfx
*.p12
secrets.json

# Local secret overrides for ops scripts (never commit real secrets)
scripts/*.secrets.ps1

# Stray error dumps (untrack existing ones with:
#   git rm --cached client/err*.txt client/receipt-err.txt )
err*.txt
*-err.txt

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test/temp
coverage/
tmp/
temp/

# Claude Code (local agent state & worktrees)
.claude/

# Google service account keys — never in the repo, and gitleaks would flag
# them anyway. Keep them outside the working tree or in the host's env vars.
*-service-account*.json
*serviceaccount*.json
adlm-ai-*.json
# Added by `vercel link`. .vercel holds the project/org ids; .env* would
# otherwise be one `git add .` away from committing real credentials.
.vercel
.env*
# server/.env.example is tracked on purpose — it documents the variables the
# server needs. Already-tracked files are not affected by an ignore rule, but
# spelling the exception out keeps the next .env.example from being swallowed.
!.env.example
