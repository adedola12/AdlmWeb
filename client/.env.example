# ADLM Website — client environment template
# Copy to `client/.env.local` and fill in real values. NEVER commit real envs.

# Backend API origin (no trailing slash)
VITE_API_BASE=http://localhost:4000

# Cloudinary (unsigned uploads)
VITE_CLOUDINARY_CLOUD_NAME=xxx
VITE_CLOUDINARY_UNSIGNED_PRESET=xxx

# Google Sign-In — OAuth 2.0 Web client ID from Google Cloud Console.
# Must be the SAME value as GOOGLE_CLIENT_ID in server/.env, and the site
# origin (e.g. https://www.adlmstudio.net + http://localhost:5173 for dev)
# must be listed under "Authorized JavaScript origins" for that client.
# Leave empty to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
