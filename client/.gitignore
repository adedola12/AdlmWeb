# Generated from src/data/changelogs/*.md by scripts/gen-changelogs.mjs.
# The markdown is the source of truth; this file is build output.
#
# It used to be tracked, which meant any local build or dev run dirtied the
# working tree and blocked the next `git pull` with "local changes would be
# overwritten". It is regenerated by the prebuild / predev / prelint hooks,
# so nothing needs the committed copy.
src/data/changelogs.js
