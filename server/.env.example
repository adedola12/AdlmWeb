# ADLM Website — server environment template
# Copy to `server/.env` and fill in REAL values. NEVER commit the real .env.
# `.env` and `.env.*` are gitignored (this `.env.example` is the only exception).
#
# CRITICAL (server refuses to boot without these — see validateEnv() in index.js)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dbname
JWT_ACCESS_SECRET=replace-with-32+char-random-string
JWT_REFRESH_SECRET=replace-with-DIFFERENT-32+char-random-string

# Plugin license signing ------------------------------------------------------
# HS256 (legacy, symmetric — the shared secret is distributed to plugins, so
# anyone with it can forge tokens). Kept for plugins not yet on RS256.
JWT_LICENSE_SECRET=replace-with-strong-random-secret
# RS256 (preferred, asymmetric — private key never leaves the server; plugins
# verify via /.well-known/jwks.json). Flip the algo once QUIV+Civil ship
# RS256-aware builds.
ADLM_LICENSE_SIGNING_ALGO=HS256
# JWT_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Payments (Paystack) ---------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_or_live_xxx
# Frontend origin used for the Paystack callback_url (also used by admin emails)
PUBLIC_WEB_URL=https://www.adlmstudio.net

# Media / storage -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
# Cloudflare R2 / S3-compatible
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=xxx
# BunnyCDN stream (video)
BUNNY_STREAM_API_KEY=xxx
BUNNY_STREAM_LIB_ID=xxx

# AWS — course video archive (masters land here, delivery is built from them)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_VIDEO_ARCHIVE_BUCKET=adlm-course-archive
AWS_VIDEO_DELIVERY_BUCKET=adlm-course-delivery
AWS_MEDIACONVERT_ENDPOINT=https://xxxxxxxx.mediaconvert.eu-west-1.amazonaws.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/MediaConvert_Default_Role

# CloudFront delivery. Must be a subdomain of the site so signed cookies set by
# the API are readable by the CDN — see docs/COURSE_VIDEO_PIPELINE.md.
AWS_CLOUDFRONT_DOMAIN=video.adlmstudio.net
AWS_CLOUDFRONT_KEY_PAIR_ID=K2XXXXXXXXXXXX
AWS_CLOUDFRONT_PRIVATE_KEY=/secure/path/cf_private_key.pem
AWS_CLOUDFRONT_PIN_IP=false
COOKIE_DOMAIN=.adlmstudio.net

# How many lectures one account may stream at the same time. This is the lever
# against a single login being shared around a study group. Default 2.
COURSE_MAX_CONCURRENT_STREAMS=2

# Service account key for reading class recordings out of Google Drive.
# Either an absolute path to the downloaded JSON key, or the JSON itself.
# The Drive folder must be shared with the service account's email.
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# Email -----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@adlmstudio.net
SMTP_PASS=gmail-app-password
RESEND_API_KEY=re_xxx

# Integrations ----------------------------------------------------------------
# OPENAI_API_KEY removed 2026-07-29 — the site talks to one model provider.
# Revoke any key still held for it; nothing reads this variable any more.
NOTION_API_KEY=secret_xxx
NOTION_CRM_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ADLM AI Agent ("Ada") — conversational sales agent at /agent/chat -----------
# Master switch. When not "true" the widget shows a friendly offline fallback.
AGENT_ENABLED=true
# AGENT_PROVIDER is no longer read — Anthropic is the only transport. Left
# documented because a stale "openai" value in a deployed environment logs a
# warning at startup rather than silently selecting a provider that is gone.
# Required. Your funded Claude key.
ANTHROPIC_API_KEY=sk-ant-xxx
# Model id. Default: claude-haiku-4-5-20251001 (fast + cheap — ideal for a
# public chat widget). Bump to a Sonnet id for richer answers at higher cost.
AGENT_MODEL=claude-haiku-4-5-20251001
# Optional: cap output tokens per model round-trip (default 700).
# AGENT_MAX_TOKENS=700
# WhatsApp number for the human-handoff button (digits only, country code first).
SUPPORT_WHATSAPP=2348106503524

# ADLM AI Service (separate serverless API on AWS — repo: adlm-ai-service).
# Base URL of the deployed API Gateway stage, no trailing slash. When UNSET,
# Ada's cost-intelligence tools (check_my_rates / find_project_errors /
# suggest_rate) are simply not offered — everything else works unchanged.
# Ada forwards the SIGNED-IN USER'S OWN token to it, so the call is metered and
# entitlement-checked against their account (needs the active "ai" add-on).
# ADLM_AI_URL=https://rced0gx4rj.execute-api.us-east-1.amazonaws.com
# Optional: per-call timeout in ms (default 45000). Measured on the deployed
# stack 2026-07-28: cache hit ~0.8s, uncached rate-buildup 22.8s, 12-line
# boq-check 16.9s. Keep this well above the slowest uncached call.
# ADLM_AI_TIMEOUT_MS=45000
# Model the AI service runs, used ONLY to price its calls locally when the
# service doesn't report which model it used (default claude-haiku-4-5).
# ADLM_AI_MODEL=claude-haiku-4-5

# Prompt caching. Ada resends ~6,300 tokens of catalogue + rules + tool defs on
# every round-trip; caching them is the biggest single lever on AI spend.
# "1h" (default) suits bursty traffic — the 5m window expires between visitors,
# so most calls would pay the write premium instead of the read discount. A 1h
# write costs 2x the input rate vs 1.25x for 5m, and pays for itself after 2
# cached reads within the hour. Set to "5m" for the standard window.
# AGENT_CACHE_TTL=1h
# Set to "false" to disable prompt caching entirely.
# AGENT_PROMPT_CACHE=true

# AI usage metering & allocations (admin page: /admin/ai-usage) ----------------
# Every AI call — Ada, HelpBot and the AWS AI service — writes an AiUsage row
# with tokens and an estimated cost, which is what the dashboard and the AWS
# credit burn-down are built on.
# Set to "false" to record usage but stop enforcing per-user monthly
# allocations (metering always stays on).
# AI_ALLOCATION_ENFORCE=true
# Starting value for the credit burn-down. The admin page overrides this once
# a total is saved there, so this is only the bootstrap value.
# AWS_CREDIT_TOTAL_USD=5000
# Ada calls api.anthropic.com by default, so its spend is NOT AWS credit. If you
# move it onto Bedrock, set this to "aws" and it joins the credit burn-down.
# AGENT_BILLING_ACCOUNT=anthropic
# Correct or add a model price without a deploy — USD per 1M tokens.
# AI_PRICES_JSON={"claude-haiku-4-5":{"in":1,"out":5}}
# Price used for an unrecognised model, so new models never look free.
# AI_PRICE_FALLBACK_IN=1.0
# AI_PRICE_FALLBACK_OUT=5.0
# Optional retention for the raw call log. 0 (default) keeps every row.
# AI_USAGE_TTL_DAYS=0

# TimeMgt task database (separate Atlas cluster, read/write by web/mobile clients)
# The WPF desktop app writes directly to this cluster; Express exposes it via REST.
TIMEMGT_MONGO_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@timemgt.lsbs0in.mongodb.net/?appName=TimeMgt
TIMEMGT_DB=TimeMgt
TIMEMGT_COLLECTION=LaborTasks

# Runtime ---------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Comma-separated allowed CORS origins (see index.js)
CORS_ORIGINS=https://www.adlmstudio.net,https://adlmstudio.net
# Set to "1"/"true" to serve the built client from this server
SERVE_CLIENT=false
# Expiry-notifier cron (defaults: enabled, 9am Africa/Lagos)
ENABLE_EXPIRY_CRON=true
EXPIRY_CRON=0 9 * * *
# Auto-renewal cron — charges saved Paystack cards (NGN) for entitlements with
# autoRenew=true expiring within RENEW_WINDOW_DAYS. Runs before the expiry
# notifier so renewed users don't get an "expiring soon" email the same day.
# Defaults: enabled, 8am Africa/Lagos, 3-day window.
ENABLE_RENEWAL_CRON=true
RENEWAL_CRON=0 8 * * *
RENEW_WINDOW_DAYS=3

# Optional: PNG burned into every rung at encode time. Survives fullscreen,
# screenshots and screen recording, unlike the DOM overlay — but is identical
# for every viewer, so it proves provenance, not identity. Key is relative to
# the archive bucket.
COURSE_AWS_WATERMARK_PNG_KEY=branding/adlm-watermark.png
